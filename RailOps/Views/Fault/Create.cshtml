
@model RailOps.Models.FaultCreateViewModel

@{
    ViewData["Title"] = "Yeni Arıza Kaydı";
}

<div class="container py-4">

    <h3 class="mb-4">Yeni Arıza Kaydı</h3>

    <form asp-controller="Fault"
          asp-action="Create"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="FaultTitle"
                   class="form-label">
                Arıza Başlığı
            </label>

            <input asp-for="FaultTitle"
                   class="form-control" />

            <span asp-validation-for="FaultTitle"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FaultLocation"
                   class="form-label">
                Arıza Konumu
            </label>

            <input asp-for="FaultLocation"
                   class="form-control" />

            <span asp-validation-for="FaultLocation"
                  class="text-danger"></span>
        </div>
        <!-- TEST-13/B-3: Sorumlu teknik ekip seçimi -->
        <div class="mb-3">

            <label asp-for="ResponsibleWorkTeamId"
                   class="form-label">
                Sorumlu Teknik Ekip
            </label>

            <select asp-for="ResponsibleWorkTeamId"
                    asp-items="Model.WorkTeamOptions"
                    class="form-select">

                <option value="">
                    -- Teknik ekip seçiniz --
                </option>

            </select>

            <span asp-validation-for="ResponsibleWorkTeamId"
                  class="text-danger">
            </span>

            <div class="form-text">
                Arızanın yönlendirileceği teknik ekibi seçiniz.
            </div>

        </div>
        <div class="mb-3">
            <label asp-for="FaultDescription"
                   class="form-label">
                Arıza Açıklaması
            </label>

            <textarea asp-for="FaultDescription"
                      class="form-control"
                      rows="4"></textarea>

            <span asp-validation-for="FaultDescription"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Arıza Kaydet
        </button>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Vazgeç
        </a>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
