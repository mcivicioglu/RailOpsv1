@using RailOps.Entities
@using RailOps.Helpers
@model IEnumerable<FaultStatusHistory>

<div class="card mt-4">
    <div class="card-body">

        <h5 class="card-title mb-4">
            Arıza Hareket Geçmişi
        </h5>

        @if (!Model.Any())
        {
            <div class="alert alert-light border">
                Bu arızaya ait kayıtlı durum geçmişi
                bulunmuyor.
            </div>
        }
        else
        {
            <div class="border-start ps-3">

                @foreach (var item in Model
                    .OrderBy(x => x.ChangedAtUtc)
                    .ThenBy(x => x.FaultStatusHistoryId))
                {
                    var actionText =
                        (item.FromStatus, item.ToStatus) switch
                        {
                            (null, FaultStatus.Open)
                                => "Arıza oluşturuldu",

                            (FaultStatus.Open,
                             FaultStatus.InProgress)
                                => "Arıza üstlenildi",

                            (FaultStatus.InProgress,
                             FaultStatus.Resolved)
                                => "Müdahale tamamlandı",

                            (FaultStatus.Resolved,
                             FaultStatus.InProgress)
                                => "Çözüm reddedildi",

                            (FaultStatus.Resolved,
                             FaultStatus.Closed)
                                => "Arıza kapatıldı",

                            _ => "Durum güncellendi"
                        };

                    var fromText = item.FromStatus switch
                    {
                        null => "Başlangıç",
                        FaultStatus.Open => "Açık",
                        FaultStatus.InProgress => "İşlemde",
                        FaultStatus.Resolved => "İşletme Onayı Bekliyor",
                        FaultStatus.Closed => "Kapandı",
                        _ => "Bilinmiyor"
                    };

                    var toText = item.ToStatus switch
                    {
                        FaultStatus.Open => "Açık",
                        FaultStatus.InProgress => "İşlemde",
                        FaultStatus.Resolved => "İşletme Onayı Bekliyor",
                        FaultStatus.Closed => "Kapandı",
                        _ => "Bilinmiyor"
                    };

                    <div class="mb-4 ps-2">

                        <h6 class="mb-1">
                            @actionText
                        </h6>

                        <p class="text-muted small mb-2">
                            @fromText → @toText
                        </p>

                        <div class="small">
                            <strong>Personel:</strong>

                            @(item.ChangedByUser?.FullName
                                ?? item.ChangedByUser?.UserName
                                ?? "Bilinmeyen personel")
                        </div>


                        <div class="text-muted small mt-1">
                            <strong>Tarih:</strong>

                            @TurkeyTime.Format(item.ChangedAtUtc)
                        </div>


                    </div>
                }

            </div>
        }

    </div>
</div>
