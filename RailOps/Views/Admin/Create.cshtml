@model RailOps.ViewModels.AdminUserCreateViewModel
@using RailOps.Entities
@{
    ViewData["Title"] = "Yeni Personel";
}

<div class="container py-4">

    <div class="mb-4">
        <h3>Yeni Personel Oluştur</h3>
        <p class="text-muted">
            Personel bilgilerini ve erişim rolünü belirleyin.
        </p>
    </div>
    <div class="card">
        <div class="card-body">

            <form asp-controller="Admin"
                  asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="SicilNo"
                           class="form-label"></label>

                    <input asp-for="SicilNo"
                           class="form-control"
                           autocomplete="off" />

                    <span asp-validation-for="SicilNo"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName"
                           class="form-label"></label>

                    <input asp-for="FullName"
                           class="form-control" />

                    <span asp-validation-for="FullName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role"
                           class="form-label"></label>

                    <select asp-for="Role"
                            class="form-select">

                        <option value="">Rol seçiniz</option>

                        <option value="TechnicalStaff">
                            Teknik Personel
                        </option>

                        <option value="OperationsStaff">
                            İşletme Personeli
                        </option>

                    </select>

                    <span asp-validation-for="Role"
                          class="text-danger"></span>
                </div>

                <!-- Teknik personele özel ekip seçimi -->
                <div id="workTeamSection" class="mb-3 d-none">

                    <label asp-for="WorkTeamId"
                           class="form-label">
                        Bağlı Olduğu Ekip
                    </label>

                    <select asp-for="WorkTeamId"
                            asp-items="Model.WorkTeamOptions"
                            class="form-select">

                        <option value="">
                            — Ekip seçiniz (isteğe bağlı) —
                        </option>

                    </select>

                    <span asp-validation-for="WorkTeamId"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        Personelin bağlı olduğu teknik ekibi seçin.
                        Ekip ataması daha sonra da yapılabilir.
                    </div>

                    @* Teknik personel görev unvanı *@
                    <div id="jobTitleSection" class="mb-3 d-none">

                        <label asp-for="JobTitle"
                               class="form-label fw-semibold">
                            Görev Unvanı
                        </label>

                        <select asp-for="JobTitle"
                                class="form-select">

                            <option value="">
                                — Görev unvanı seçiniz (isteğe bağlı) —
                            </option>

                            <option value="@((int)TechnicalJobTitle.Chief)">
                                Şef
                            </option>

                            <option value="@((int)TechnicalJobTitle.Engineer)">
                                Mühendis
                            </option>

                            <option value="@((int)TechnicalJobTitle.Foreman)">
                                Formen
                            </option>

                            <option value="@((int)TechnicalJobTitle.Technician)">
                                Teknisyen
                            </option>

                        </select>

                        <span asp-validation-for="JobTitle"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="mb-3">
                    <label asp-for="Password"
                           class="form-label"></label>

                    <input asp-for="Password"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="Password"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword"
                           class="form-label"></label>

                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Personeli Kaydet
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Vazgeç
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const roleSelect =
                document.getElementById("Role");

            const teamSection =
                document.getElementById("workTeamSection");

            const teamSelect =
                document.getElementById("WorkTeamId");

            function updateWorkTeamVisibility() {

                const isTechnicalStaff =
                    roleSelect.value === "TechnicalStaff";

                // Teknik personelse göster
                teamSection.classList.toggle(
                    "d-none",
                    !isTechnicalStaff
                );

                // Diğer rollerde form gönderimine dahil etme
                teamSelect.disabled = !isTechnicalStaff;

                // Rol değiştiyse eski ekip seçimini temizle
                if (!isTechnicalStaff) {
                    teamSelect.value = "";
                }
            }

            // Kullanıcı rol değiştirdiğinde
            roleSelect.addEventListener(
                "change",
                updateWorkTeamVisibility
            );

            // Sayfa ilk açıldığında da kontrol et
            updateWorkTeamVisibility();

        });

        document.addEventListener("DOMContentLoaded", function () {

            const roleSelect =
                document.getElementById("Role");

            const jobTitleSection =
                document.getElementById("jobTitleSection");

            const jobTitleSelect =
                document.getElementById("JobTitle");

            function updateJobTitleVisibility() {

                const isTechnical =
                    roleSelect.value === "TechnicalStaff";

                jobTitleSection.classList.toggle(
                    "d-none", !isTechnical
                );

                jobTitleSelect.disabled = !isTechnical;

                if (!isTechnical) {
                    jobTitleSelect.value = "";
                }
            }

            roleSelect.addEventListener(
                "change", updateJobTitleVisibility
            );

            updateJobTitleVisibility();
        });

    </script>
}

