@model List<RailOps.ViewModels.AdminUserListItemViewModel>

@{
    ViewData["Title"] = "Personel Yönetimi";
}

<div class="container py-4">

    <div class="mb-4">
        <h3>Personel Yönetimi</h3>

        <a asp-controller="Admin"
           asp-action="Create"
           class="btn btn-primary">
            Yeni Personel
        </a>

        <p class="text-muted">
            Sistemde kayıtlı personeller ve rolleri
        </p>
    </div>

    <div class="card">
        <div class="card-body">
            @if (TempData["AdminError"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show"
                     role="alert">

                    @errorMessage

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Kapat">
                    </button>
                </div>
            }
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    Henüz kayıtlı kullanıcı bulunmuyor.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Sicil No</th>
                                <th>Ad Soyad</th>
                                <th>Roller</th>
                                <th>İşlemler</th>
                                <th>Durum</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@user.SicilNo</strong>
                                    </td>

                                    <td>@user.FullName</td>

                                    <td>
                                        @if (user.Roles.Any())
                                        {
                                            foreach (var role in user.Roles)
                                            {
                                                <span class="badge bg-secondary me-1">
                                                    @role
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Rol atanmamış
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (!user.Roles.Contains("Admin"))
                                        {
                                            <a asp-controller="Admin"
                                               asp-action="Edit"
                                               asp-route-id="@user.UserId"
                                               class="btn btn-sm btn-outline-primary me-1">
                                                Düzenle
                                            </a>

                                            <form asp-controller="Admin"
                                                  asp-action="SetActive"
                                                  asp-route-id="@user.UserId"
                                                  method="post"
                                                  asp-antiforgery="true"
                                                  class="d-inline">

                                                <input type="hidden"
                                                       name="isActive"
                                                       value="@(user.IsActive ? "false" : "true")" />

                                                @if (user.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        Pasifleştir
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        Aktifleştir
                                                    </button>
                                                }

                                                <a asp-controller="Admin"
                                                   asp-action="ResetPassword"
                                                   asp-route-id="@user.UserId"
                                                   class="btn btn-sm btn-outline-secondary">
                                                    Parola Sıfırla
                                                </a>

                                            </form>
                                        }
                                    </td>

                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Pasif
                                            </span>
                                        }
                                    </td>

                                   


                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

            @if (TempData["AdminSuccess"] is string success)
            {
                <div class="alert alert-success">
                    @success
                </div>
            }

            @if (TempData["AdminError"] is string error)
            {
                <div class="alert alert-danger">
                    @error
                </div>
            }


        </div>
    </div>
</div>
