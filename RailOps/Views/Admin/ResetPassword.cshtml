@model RailOps.ViewModels.AdminPasswordResetViewModel

@{
    ViewData["Title"] = "Personel Parola Sıfırlama";
}

<div class="container py-4">

    <h3>Personel Parola Sıfırlama</h3>

    <p class="text-muted">
        Bu işlem mevcut parolayı geçersiz kılar.
    </p>

    <div class="card">
        <div class="card-body">

            <form asp-controller="Admin"
                  asp-action="ResetPassword"
                  method="post"
                  asp-antiforgery="true">

                <input asp-for="UserId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">
                        Sicil Numarası
                    </label>

                    <input value="@Model.SicilNo"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="TemporaryPassword"
                           class="form-label"></label>

                    <input asp-for="TemporaryPassword"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="TemporaryPassword"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmTemporaryPassword"
                           class="form-label"></label>

                    <input asp-for="ConfirmTemporaryPassword"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmTemporaryPassword"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="AdminPassword"
                           class="form-label"></label>

                    <input asp-for="AdminPassword"
                           class="form-control"
                           autocomplete="current-password" />

                    <span asp-validation-for="AdminPassword"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-danger">
                        Parolayı Sıfırla
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Vazgeç
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
